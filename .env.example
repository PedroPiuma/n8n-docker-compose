# ==============================================================================
# n8n Docker Compose - Configurações de Ambiente (.env)
# ==============================================================================
# NOTA: Todas as variáveis possuem valores padrão seguros no docker-compose.yml.
# Você só precisa preencher ou alterar caso deseje customizar.

# --- Portas no Host ---
N8N_PORT=5678
WAHA_PORT=3008
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- n8n ---
# URL externa/pública para receber webhooks de fora (ex: ngrok, domínio ou localhost)
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
N8N_LOG_LEVEL=info
# Execuções simultâneas de webhook (o excedente aguarda em fila)
N8N_CONCURRENCY_PRODUCTION_LIMIT=5
# none = salva só execuções com erro; all = salva todas (útil para depurar)
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
# Retenção do histórico de execuções, em horas
EXECUTIONS_DATA_MAX_AGE=168

# --- WAHA (WhatsApp HTTP API) ---
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin123
WAHA_API_KEY=admin
WHATSAPP_DEFAULT_ENGINE=GOWS
# Filtros de eventos na origem. Ignorar grupos reduz muito a carga, mas o agente deixa de responder neles.
WAHA_IGNORE_STATUS=true
WAHA_IGNORE_GROUPS=false
WAHA_IGNORE_CHANNELS=true
WAHA_IGNORE_BROADCAST=true
# Tipos de mídia baixados para os eventos (separados por vírgula)
WAHA_EVENTS_DOWNLOAD_MEDIA_MIMETYPES=image/jpeg

# --- PostgreSQL (Banco do n8n e Sessões do WAHA) ---
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB=n8n

# --- Redis (Cache e Apps do WAHA) ---
REDIS_PASSWORD=default
